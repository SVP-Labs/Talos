{
    "name": "svp-labs/ledger-mutation",
    "description": "A Talos test project: tests that leave a mutant alive.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "infection/infection": "0.35.8",
        "pestphp/pest": "5.3.3"
    },
    "autoload": {
        "psr-4": {
            "Ledger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
